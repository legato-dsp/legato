patch fm(freq = 220.0) {
    audio {
        sine: carrier { freq: $freq },
        sine: mod { freq: $freq }
    }

    carrier >> mod.freq

    { mod }
}

patch reverb(
    chans = 2,
    gain = 1.0
) {
    in audio_in

    audio {
        allpass * 4 { delay_length: 20, feedback: 0.5, chans: $chans },
        gain { val: $gain, chans: $chans }
    }

    audio_in >> allpass(0)
    allpass(0) >> allpass(1)
    allpass(1) >> allpass(2)
    allpass(2) >> allpass(3)

    allpass(3) >> gain

    { gain }
}

audio {
    fm * 8 { freq: 880.0 },
    track_mixer { tracks: 8, chans_per_track: 1 },
    reverb { gain: 1.0, chans: 2 }
}

fm(*) >> track_mixer >> reverb

{ reverb }
