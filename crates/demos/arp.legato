// title: Arp Chance
// desc: Hold a chord on MIDI channel 1. An up-down arpeggio over two octaves steps on a sixteenth-note clock, and roughly a third of its notes are dropped at random.

patch voice(
    attack = 2.0,
    decay = 90.0,
    sustain = 0.2,
    release = 120.0
) {
    in freq gate trig

    audio {
        saw { chans: 1 },
        adsr { attack: $attack, decay: $decay, sustain: $sustain, release: $release, chans: 1 },
    }

    freq >> saw
    gate >> adsr.gate
    trig >> adsr.trig
    saw >> adsr[1]

    { adsr }
}

patches {
    voice * 4 { },
}

control {
    clock { bpm: 120.0, division: 8, steps: 16 },
}

midi {
    arp { steps: 16, mode: "updown", octaves: 2, gate: 0.6 },
    chance { p: 1.0 },
    poly_voice { chan: 0, voices: 4 },
}

audio {
    track_mixer: mixer { tracks: 4, chans_per_track: 1, gain: [0.15, 0.15, 0.15, 0.15] },
    svf { chans: 1, cutoff: 2400.0, q: 0.6, type: "lowpass" },
    mono_fan_out { chans: 2 },
}

clock >> arp.phasor
arp >> chance >> poly_voice >> voice(*)
voice(*) >> mixer[0..4]

mixer >> svf >> mono_fan_out

{ mono_fan_out }
