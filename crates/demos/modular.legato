// title: Modular Poly
// desc: Five generative voices using quantized sampled noise for melody generation.

patch voice(
    attack = 300.0,
    decay = 300.0,
    sustain = 0.4,
    release = 500.0
) {
    in freq gate

    audio {
        saw { chans: 1 },
        adsr { attack: $attack, decay: $decay, sustain: $sustain, release: $release, chans: 1 },
    }

    freq >> saw
    gate >> adsr.gate
    saw >> adsr[1]

    { adsr }
}

patch generative_voice {
    patches {
        voice { },
    }

    audio {
        svf: svf1 { chans: 1, cutoff: 300.0, q: 0.2, type: "highpass" },
        svf: svf2 { chans: 1, cutoff: 2400.0, q: 0.2, type: "lowpass" },
    }

    modular {
        random { rate: 120.0, prob: 0.1, range: [ 32.0, 96.0] },
        quantize { notes: [0, 2, 3, 9, 10, 5] },
        trig_to_gate { gate_time: 1200.0 }
    }

    random.stepped >> quantize

    quantize.trig >> trig_to_gate >> voice.gate
    quantize.freq >> voice.freq

    voice >> svf1 >> svf2

    { svf2 }
}

patch smear(){
    in audio

    audio {
        grain_delay {
            chans: 2,
            diffusion: 1.0,
            grain_size: 400,
            spray: 6.0,
            damping: 0.8,
            scan: 1.0,
            delay_length: 1000,
            shape: 0.5,
            feedback: 0.8
        },
        plate480 { mix: 0.8, decay: 0.8 },
        track_mixer: wet_dry { chans_per_track: 2, tracks: 2, gain: [0.0, 0.7] },
    }

    audio >> grain_delay >> plate480

    audio >> wet_dry[0..2]
    plate480 >> wet_dry[2..4]

    { wet_dry }
}

patches {
    generative_voice * 5 {},
    smear {}
}

audio {
    track_mixer { tracks: 5, chans_per_track: 1 },
    mono_fan_out { chans: 2 },
}

generative_voice(*) >> track_mixer

track_mixer >> mono_fan_out >> smear

{ smear }
